# GAMERCARD / Zero.2
# Matches the handheld: matte black chassis, champagne-gold branding, ivory and grey.
# Gold plays the same role Ubuntu purple does — directories, prompt accents, cursor.

background = #000000
foreground = #E8E4DC
cursor     = #C9A86C

