color4  = #C9A86C
color5  = #B08978
color6  = #A8B0B8
color7  = #E8E4DC

# 8-15 bright
color8  = #5A5A5A
color9  = #D47868
color10 = #A8B888
color11 = #F0D9A0
color12 = #D4C4A0
color13 = #C9A890
